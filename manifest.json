{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "bookmarks",
    "topSites"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://wttr.in/*"
  ],
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-window-fullscreen": {
      "description": "__MSG_windowFullscreenShortcut__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: https://www.bing.com https://wttr.in ws://127.0.0.1:* ws://localhost:* wss://127.0.0.1:* wss://localhost:*;"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
